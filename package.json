{
  "name": "mission-command-center",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Local dashboard for Claude Code power users — monitor sessions, manage tasks, and launch terminals from one browser tab",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite\" \"npm run dev:open\"",
    "dev:open": "sleep 2 && open http://localhost:5173/mission-command-center/",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "uuid": "^10.0.0",
    "ws": "^8.21.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.3.1"
  }
}
